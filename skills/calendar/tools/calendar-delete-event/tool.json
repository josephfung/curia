{
  "name": "calendar-delete-event",
  "description": "Delete a calendar event. By default, attendees receive cancellation emails. Set notifyAttendees to false to suppress cancellation notifications.",
  "version": "1.0.2",
  "sensitivity": "normal",
  "action_risk": "high",
  "install": { "requires_secrets": ["nylas_api_key", "ceo_nylas_grant_id"] },
  "inputs": {
    "calendarId": "string",
    "eventId": "string",
    "notifyAttendees": "boolean?"
  },
  "outputs": {
    "deleted": "boolean"
  },
  "permissions": [],
  "secrets": [],
  "timeout": 15000,
  "capabilities": [
    "nylasCalendarClient"
  ],
  "allowed_callers": [
    "calendar"
  ]
}
