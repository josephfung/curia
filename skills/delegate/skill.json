{
  "name": "delegate",
  "description": "Delegate a task to a specialist agent. Use this when the user's request requires specialized expertise (research, expense tracking, etc.). Provide the specialist's name and a clear task description.",
  "version": "1.0.0",
  "sensitivity": "normal",
  "action_risk": "none",
  "inputs": {
    "agent": "string",
    "task": "string",
    "conversation_id": "string?",
    "timeout_ms": "number?",
    "resume_token": "string?"
  },
  "outputs": {
    "response": "string?",
    "agent": "string",
    "needs_clarification": "boolean?",
    "question": "string?",
    "context": "string?",
    "resume_token": "string?"
  },
  "permissions": [],
  "secrets": [],
  "timeout": 660000,
  "capabilities": [
    "bus",
    "agentRegistry"
  ],
  "allowed_callers": ["coordinator"]
}
