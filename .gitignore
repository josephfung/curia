# Dependencies
node_modules/

# This project uses pnpm; npm must not generate a competing lockfile
package-lock.json
yarn.lock

# Build output
dist/

# Environment and secrets
.env
.env.local
.env.production

# Config overrides (only default.yaml is tracked)
config/local.yaml
config/production.yaml

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo

# Test coverage
coverage/

# Dev log file (pino writes here in dev mode to keep CLI clean)
curia.log

# Docker volumes
pgdata/

# Smoke test outputs (timestamped, not committed)
tests/smoke/results/*.json
tests/smoke/reports/*.html

# Claude Code local skills (managed by trimkit, not committed)
.claude/skills/

# Red team artifacts (rendered system prompt, generated test cases, and run
# outputs — may contain production identity details and security test content)
tests/redteam/coordinator-system-prompt.txt
tests/redteam/redteam.yaml
tests/redteam/results/

# Superpowers subagent-driven-development scratch (task briefs, reports, review
# diffs) — local workflow artifacts, never committed
.superpowers/
