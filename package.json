{
  "name": "curia",
  "version": "0.34.0",
  "description": "The AI executive staff your C-Suite will use and your Board will trust",
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "predev": "pnpm migrate",
    "dev": "concurrently -n bk,ui -c blue,cyan 'tsx watch --env-file=.env --ignore curia.log src/index.ts' 'pnpm --filter @curia/console run dev'",
    "build:console": "pnpm --filter @curia/console run build",
    "prelocal": "pnpm migrate",
    "local": "eval $(grep '^[A-Z]' .env | sed 's/^/export /') && tsx --env-file=.env src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "migrate": "tsx --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up --migrations-dir src/db/migrations --migration-file-language sql",
    "smoke": "tsx --env-file=.env tests/smoke/cli.ts",
    "inspect-prompts": "tsx --env-file=.env scripts/inspect-prompts.ts",
    "render-coordinator-prompt": "tsx --env-file=.env scripts/render-coordinator-prompt.ts",
    "redteam": "promptfoo redteam run --config tests/redteam/promptfooconfig.yaml --env-file .env",
    "redteam:report": "promptfoo view",
    "backfill:contact-attributes": "tsx --env-file=.env scripts/backfill-contact-attributes.ts",
    "seed-vault": "tsx --env-file=.env scripts/seed-vault.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^9.1.3",
    "@ghostery/adblocker-playwright": "^2.18.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "chokidar": "^5.0.0",
    "cose-base": "^2.2.0",
    "cron-parser": "^5.5.0",
    "cytoscape": "^3.34.0",
    "cytoscape-fcose": "^2.2.0",
    "fastify": "^5.8.5",
    "googleapis": "^173.0.0",
    "js-yaml": "^4.2.0",
    "layout-base": "^2.0.1",
    "libphonenumber-js": "^1.13.6",
    "luxon": "^3.7.2",
    "node-html-parser": "^7.1.0",
    "node-pg-migrate": "^8.0.4",
    "nylas": "^8.1.2",
    "openai": "^6.42.0",
    "openredaction": "^1.1.2",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "pgvector": "^0.3.0",
    "pino": "^10.3.1",
    "playwright": "^1.61.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "sanitize-html": "^2.17.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chokidar": "^2.1.7",
    "@types/js-yaml": "^4.0.9",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.61.1",
    "@typescript-eslint/parser": "^8.61.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.5.0",
    "pino-pretty": "^13.1.3",
    "promptfoo": "^0.121.15",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  }
}
