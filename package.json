{
  "name": "curia",
  "version": "0.32.0",
  "description": "The AI executive staff your C-Suite will use and your Board will trust",
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "predev": "pnpm migrate",
    "dev": "concurrently -n bk,ui -c blue,cyan 'tsx watch --env-file=.env --ignore curia.log src/index.ts' 'pnpm --filter @curia/console run dev'",
    "build:console": "pnpm --filter @curia/console run build",
    "prelocal": "pnpm migrate",
    "local": "eval $(grep '^[A-Z]' .env | sed 's/^/export /') && tsx --env-file=.env src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/",
    "migrate": "tsx --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up --migrations-dir src/db/migrations --migration-file-language sql",
    "smoke": "tsx --env-file=.env tests/smoke/cli.ts",
    "inspect-prompts": "tsx --env-file=.env scripts/inspect-prompts.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.1",
    "@ghostery/adblocker-playwright": "^2.17.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "chokidar": "^5.0.0",
    "cose-base": "^2.2.0",
    "cron-parser": "^5.5.0",
    "cytoscape": "^3.33.4",
    "cytoscape-fcose": "^2.2.0",
    "fastify": "^5.8.5",
    "js-yaml": "^4.2.0",
    "layout-base": "^2.0.1",
    "luxon": "^3.7.2",
    "node-pg-migrate": "^8.0.4",
    "nylas": "^8.1.2",
    "openai": "^6.39.0",
    "openredaction": "^1.1.2",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "pgvector": "^0.2.1",
    "pino": "^10.3.1",
    "playwright": "^1.60.0",
    "sanitize-html": "^2.17.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "overrides": {
      "hono": ">=4.12.18",
      "fast-uri": ">=3.1.2",
      "vite": ">=8.0.5",
      "qs": ">=6.15.2",
      "ip-address": ">=10.1.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chokidar": "^2.1.7",
    "@types/js-yaml": "^4.0.9",
    "@types/luxon": "^3.7.1",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "concurrently": "^9.1.2",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
