{
  "name": "curia",
  "version": "0.42.0",
  "description": "The AI executive staff your C-Suite will use and your Board will trust",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "predev": "pnpm migrate",
    "dev": "concurrently -n bk,ui,af -c blue,cyan,magenta 'tsx watch --env-file=.env --ignore curia.log src/index.ts' 'pnpm --filter @curia/console run dev' 'pnpm --filter @curia/antfarm run dev'",
    "build:console": "pnpm --filter @curia/console run build",
    "build:antfarm": "pnpm --filter @curia/antfarm run build",
    "prelocal": "pnpm migrate",
    "local": "eval $(grep '^[A-Z]' .env | sed 's/^/export /') && tsx --env-file=.env src/index.ts",
    "build": "tsup src/index.ts --format esm --dts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:shell": "bash tests/setup/test-setup-functions.sh",
    "test:postgres-image": "bash tests/docker/test-postgres-init.sh",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.skills.json && tsc --noEmit -p tsconfig.tests.json && pnpm --filter @curia/antfarm run typecheck",
    "lint": "eslint src/ tests/",
    "migrate": "tsx --env-file=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up --migrations-dir src/db/migrations --migration-file-language sql",
    "smoke": "tsx --env-file=.env tests/smoke/cli.ts",
    "inspect-prompts": "tsx --env-file=.env scripts/inspect-prompts.ts",
    "render-coordinator-prompt": "tsx --env-file=.env scripts/render-coordinator-prompt.ts",
    "redteam": "promptfoo redteam run --config tests/redteam/promptfooconfig.yaml --env-file .env",
    "redteam:provenance": "promptfoo redteam run --config tests/redteam/promptfooconfig-provenance.yaml --env-file .env",
    "redteam:provenance:external": "REDTEAM_COHORT=external pnpm redteam:provenance",
    "redteam:provenance:principal": "REDTEAM_COHORT=principal pnpm redteam:provenance",
    "redteam:provenance:smoke": "tsx tests/redteam/smoke-provenance.ts",
    "redteam:report": "promptfoo view",
    "backfill:contact-attributes": "tsx --env-file=.env scripts/backfill-contact-attributes.ts",
    "rederive:contact-tiers": "tsx --env-file=.env scripts/rederive-contact-tiers.ts",
    "dedup:contacts": "tsx --env-file=.env scripts/dedup-contacts.ts",
    "seed-vault": "tsx --env-file=.env scripts/seed-vault.ts",
    "audit:verify": "tsx --env-file=.env scripts/audit-verify.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@curia/shared-types": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.2",
    "@ghostery/adblocker-playwright": "^2.18.1",
    "@livekit/rtc-node": "^0.13.31",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@slack/socket-mode": "^3.0.0",
    "@slack/web-api": "^8.0.0",
    "ajv": "^8.20.0",
    "chokidar": "^5.0.0",
    "cose-base": "^2.2.0",
    "cron-parser": "^5.6.2",
    "cytoscape": "^3.34.0",
    "cytoscape-fcose": "^2.2.0",
    "fastify": "^5.10.0",
    "googleapis": "^173.0.0",
    "js-yaml": "^5.2.2",
    "layout-base": "^2.0.1",
    "libphonenumber-js": "^1.13.9",
    "livekit-server-sdk": "^2.17.0",
    "luxon": "^3.7.2",
    "markdown-it": "^14.3.0",
    "node-html-parser": "^9.0.0",
    "node-pg-migrate": "^8.0.4",
    "nylas": "^8.4.0",
    "openai": "^6.48.0",
    "openredaction": "^1.1.2",
    "patchright": "1.61.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "pgvector": "^0.3.0",
    "pino": "^10.3.1",
    "playwright": "1.61.1",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chokidar": "^2.1.7",
    "@types/js-yaml": "^4.0.9",
    "@types/luxon": "^3.7.2",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.7.0",
    "happy-dom": "^20.11.0",
    "pino-pretty": "^13.1.3",
    "promptfoo": "^0.121.19",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
