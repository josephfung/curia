{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "default-config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "model_routing": {
      "type": "object",
      "required": ["tiers", "default_tier"],
      "additionalProperties": false,
      "properties": {
        "tiers": {
          "type": "object",
          "required": ["fast", "standard", "powerful"],
          "additionalProperties": false,
          "properties": {
            "fast":     { "$ref": "#/definitions/tierConfig" },
            "standard": { "$ref": "#/definitions/tierConfig" },
            "powerful": { "$ref": "#/definitions/tierConfig" }
          }
        },
        "default_tier": {
          "type": "string",
          "enum": ["fast", "standard", "powerful"]
        }
      }
    },
    "channels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cli": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "slack": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowed_channel_ids": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "voice": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": { "type": "string" },
            "livekit_management_url": {
              "type": "string",
              "description": "HTTP(S) base for LiveKit RoomService (DeleteRoom, etc.). Distinct from browser signaling URL. Compose default: http://livekit:7880."
            }
          }
        },
        "max_message_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionTtlMs": { "type": "integer", "minimum": 1 },
        "sweepIntervalMs": { "type": "integer", "minimum": 1 },
        "profileDir": { "type": "string" },
        "channel": { "type": "string" },
        "proxy": { "type": "string" },
        "locale": { "type": "string" }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coordinator": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "config_path": { "type": "string" }
          }
        }
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conversationCheckpointDebounceMs": { "type": "integer", "minimum": 1 },
        "rate_limit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "window_ms": { "type": "integer", "minimum": 1 },
            "max_per_sender": { "type": "integer", "minimum": 1 },
            "max_global": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "workingMemory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ttlDays": { "type": "integer", "minimum": 1 },
        "summarization": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "threshold": { "type": "integer", "minimum": 2 },
            "keepWindow": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "documentWorkspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scratchTtlDays": { "type": "integer", "minimum": 1, "maximum": 36500 },
        "kgPromotion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "maxFacts": { "type": "integer", "minimum": 0 },
            "maxRelationships": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "skillOutput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxLength": { "type": "integer", "minimum": 1 }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trust_thresholds"],
      "properties": {
        "extra_injection_patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["regex", "label"],
            "additionalProperties": false,
            "properties": {
              "regex": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        },
        "trust_score": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "channel_weight": { "type": "number", "minimum": 0, "maximum": 1 },
            "contact_weight": { "type": "number", "minimum": 0, "maximum": 1 },
            "max_risk_penalty": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "trust_score_floor": { "type": "number", "minimum": 0, "maximum": 1 },
        "trust_thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["information_query", "scheduling", "data_export", "financial"],
          "properties": {
            "information_query": { "type": "number", "minimum": 0, "maximum": 1 },
            "scheduling":        { "type": "number", "minimum": 0, "maximum": 1 },
            "data_export":       { "type": "number", "minimum": 0, "maximum": 1 },
            "financial":         { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "exportControls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "confidentialThreshold": { "type": "integer", "minimum": 1 },
        "allowedDestinations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "driveFolderIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "urls": { "type": "array", "items": { "type": "string", "minLength": 1 } },
            "filePaths": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    "intentDrift": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "checkEveryNBursts": { "type": "integer", "minimum": 1 },
        "minConfidenceToPause": { "type": "string", "enum": ["high", "medium", "low"] }
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "llmJudge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "model": { "type": "string" },
            "timeout_ms": { "type": "integer", "minimum": 250 },
            "failMode": { "type": "string", "enum": ["split", "open", "closed"] }
          }
        }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "judge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "model": { "type": "string" },
            "timeout_ms": { "type": "integer", "minimum": 250 }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "llmCallArchive": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "hotRetentionDays": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "dreaming": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decay": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "intervalMs": { "type": "integer", "minimum": 1 },
            "archiveThreshold": { "type": "number", "minimum": 0, "maximum": 1 },
            "halfLifeDays": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "permanent": { "type": "null" },
                "slow_decay": { "type": "integer", "minimum": 1 },
                "fast_decay": { "type": "integer", "minimum": 1 }
              }
            },
            "edgeCountPercentile": { "type": "number", "minimum": 0, "maximum": 1 },
            "edgeCountFloor": { "type": "integer", "minimum": 0 },
            "warnHoldBackDays": { "type": "integer", "minimum": 0 }
          }
        },
        "autonomy_scoring": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "intervalMs": { "type": "integer", "minimum": 1 },
            "model_tier": { "type": "string", "enum": ["fast", "standard", "powerful"] },
            "batchSize": { "type": "integer", "minimum": 1 },
            "minScoredActions": { "type": "integer", "minimum": 1 },
            "halfLifeDays": { "type": "number", "minimum": 1 },
            "weakExpiredWeight": { "type": "number", "minimum": 0, "maximum": 1 },
            "ceoCooldownDays": { "type": "integer", "minimum": 0 },
            "errorRateThreshold": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "sensitivity_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["category", "sensitivity", "patterns"],
        "additionalProperties": false,
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "sensitivity": { "type": "string", "enum": ["public", "internal", "confidential", "restricted"] },
          "patterns": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "pii": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extra_patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["regex", "replacement"],
            "additionalProperties": false,
            "properties": {
              "regex": { "type": "string", "minLength": 1 },
              "replacement": { "type": "string", "minLength": 1 }
            }
          }
        },
        "outbound_redaction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "default": { "type": "string", "enum": ["block", "allow"] },
            "channel_policies": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "allow": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "channel_accounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "email": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["nylas_grant_id", "self_email"],
            "additionalProperties": false,
            "properties": {
              "nylas_grant_id": { "type": "string", "minLength": 1 },
              "self_email": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "contact_creation_limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_per_message": { "type": "integer", "minimum": 1 },
        "max_per_hour": { "type": "integer", "minimum": 1 }
      }
    },
    "contextBridge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultExpiryHours": { "type": "integer", "minimum": 1 },
        "explicitExpiryHours": { "type": "integer", "minimum": 1 }
      }
    },
    "debrief": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channel": { "type": "string", "enum": ["signal", "email"] },
        "reminderDelayMinutes": { "type": "integer", "minimum": 1 },
        "contextBridgeTtlHours": { "type": "integer", "minimum": 1 }
      }
    },
    "delegate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultTimeoutMs": { "type": "integer", "minimum": 1 }
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultExpectedDurationSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "heartbeatIntervalMinutes": { "type": "integer", "minimum": 1 },
        "heartbeatMaxWakesPerTick": { "type": "integer", "minimum": 1 },
        "idleThresholdHours": { "type": "number", "minimum": 0 },
        "staleWaitThresholdHours": { "type": "number", "minimum": 0 },
        "resumableContinuationSeconds": { "type": "integer", "minimum": 1 },
        "resumableCeilings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxStalls": { "type": "integer", "minimum": 1 },
            "maxIterations": { "type": "integer", "minimum": 1 },
            "maxWallclockHours": { "type": "number", "exclusiveMinimum": 0 },
            "maxCostUsd": { "type": "number", "exclusiveMinimum": 0 },
            "maxPlanDepth": { "type": "integer", "minimum": 1 },
            "maxReplansPerSubtree": { "type": "integer", "minimum": 1 },
            "blockedStepHours": { "type": "number", "exclusiveMinimum": 0 },
            "throughputDivergenceRatio": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "autonomy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bypass_ladder": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "same_task": { "type": "integer", "minimum": 60, "maximum": 100 },
            "derived_child": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        },
        "reaction_intents": {
          "type": "object",
          "additionalProperties": false,
          "description": "Emoji → approve/reject for inbound.reaction (#1479). Channel-agnostic.",
          "properties": {
            "approve": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "reject": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "liveness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "email_stall_factor": { "type": "integer", "minimum": 1 },
            "scheduler_max_tick_s": { "type": "integer", "minimum": 1 }
          }
        },
        "canary_schedule": { "type": "string", "minLength": 1 },
        "heartbeats": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "llm_fast":         { "type": "string" },
            "llm_standard":     { "type": "string" },
            "llm_powerful":     { "type": "string" },
            "embeddings":       { "type": "string" },
            "image_gen":        { "type": "string" },
            "nylas":            { "type": "string" },
            "signal":           { "type": "string" },
            "google_workspace": { "type": "string" },
            "tavily":           { "type": "string" }
          }
        }
      }
    }
  },
  "definitions": {
    "tierConfig": {
      "type": "object",
      "required": ["model"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "minLength": 1 }
      }
    }
  }
}
