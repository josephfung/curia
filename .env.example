# Database
DB_USER=curia
DB_PASSWORD=your-db-password
# DATABASE_URL is constructed from DB_USER, DB_PASSWORD, and POSTGRES_PORT
# (default 5432) by `pnpm setup`. For manual setup, substitute the values below.
# The port here MUST match POSTGRES_PORT below — `pnpm migrate` runs host-side
# against the published postgres port; a mismatch silently routes migrations
# at the wrong DB (or no DB at all).
DATABASE_URL=postgres://curia:your-db-password@localhost:5432/curia

# TLS (macOS only) — Node installed via nvm/fnm bundles its own CA store
# and doesn't trust macOS system certificates. If HTTPS fetch fails with
# "unable to get local issuer certificate", export your system certs:
#
#   security find-certificate -a -p /System/Library/Keychains/SystemRootCertificates.keychain > ~/.config/curia/macos-ca-certs.pem
#
# Then uncomment the line below. Not needed on Linux.
# NODE_EXTRA_CA_CERTS=/Users/yourname/.config/curia/macos-ca-certs.pem

# HTTP API
HTTP_PORT=3000
# Host address the HTTP API is published on. Empty publishes on every interface
# (needed when a proxy on another host, or clients, reach :3000 directly).
# install.sh sets 127.0.0.1 for the local and HTTPS (Caddy) topologies, so :3000
# is not reachable from outside the host.
# HTTP_BIND=127.0.0.1

# Embeddings for entity memory (ADR-051). Unset uses OpenAI's text-embedding-3-small with
# the vault's openai_api_key. Set a base URL to use any OpenAI-compatible /embeddings
# server (llama.cpp, Ollama, vLLM); its key, if it needs one, is the vault's
# embedding_api_key.
# EMBEDDING_MODEL is required with a base URL; without it entity memory stays off.
# It must name a model that has a profile. text-embedding-3-small and
# Qwen3-Embedding-4B are built in, and config/local.yaml can add one under
# embedding.profiles (see config/default.yaml). The profile holds the vector width and
# the similarity thresholds, so that part of the setup lives in YAML, not here.
# The server must return at least the profile's width. A longer vector keeps its leading
# values, which suits Matryoshka-trained models such as Qwen3-Embedding-4B.
# To change the model on an install that already has vectors, stop Curia and run
# pnpm reembed:kg once.
# EMBEDDING_BASE_URL=http://localhost:8080/v1
# EMBEDDING_MODEL=Qwen3-Embedding-4B

# Published image tags (Docker Compose pulls these). Pin to a vX.Y.Z for a
# stable self-host; `latest` tracks the newest release, `edge` the newest main.
# On a fresh install, install.sh sets CURIA_IMAGE_TAG from CURIA_VERSION so the
# app image matches the release its config came from.
CURIA_IMAGE_TAG=latest
# CURIA_POSTGRES_TAG is a SEPARATE axis, keyed to the Postgres major (pg16) — the
# curia-postgres image publishes no vX.Y.Z tags, so it is not driven by CURIA_VERSION.
CURIA_POSTGRES_TAG=pg16

# Optional LiveKit voice transport. The compose service defaults to LiveKit --dev
# credentials (devkey / secret) for local testing; production must use real keys
# that match the Voice channel vault entries.
# LIVEKIT_IMAGE_TAG=latest
# LIVEKIT_COMMAND=--dev --bind 0.0.0.0
# LIVEKIT_HTTP_PORT=7880
# Signaling (7880) is published on 127.0.0.1 by default (since #2408; before,
# every interface). Set LIVEKIT_HTTP_BIND to 0.0.0.0 (IPv4) or :: (IPv4 + IPv6)
# only when browsers connect to ws(s)://<host>:7880 directly, and never with the
# --dev credentials. A TLS proxy on this host can use 127.0.0.1:7880 instead
# (set LIVEKIT_HTTP_BIND=127.0.0.1 then, to silence install.sh's loopback note;
# it never silences the warning while 7880 is still published beyond loopback).
# Existing installs apply the change with: docker compose --profile voice up -d livekit
# The RTC ports below stay public. See docs/dev/voice-setup.md.
# LIVEKIT_HTTP_BIND=127.0.0.1
# LIVEKIT_RTC_TCP_PORT=7881
# LIVEKIT_RTC_UDP_PORT=7882

# Signal voice calls (#1672). Off by default. Requires the Signal channel AND the
# fully configured Voice channel (LiveKit + Deepgram + Cartesia) AND deploy-side
# infrastructure from curia-deploy: signal-cli >= 0.14.7, the signal-call-tunnel
# binary, and PulseAudio running inside the signal-cli container with its socket
# shared to Curia. If any prerequisite is missing, Curia logs a warning at boot and
# leaves the call bridge unstarted. Liveness of the audio path is reported by the
# `signal_voice` check in /api/health.
# SIGNAL_VOICE_CALLS_ENABLED=false
# SIGNAL_PULSE_SOCKET_PATH=/var/run/pulse-shared/native
# SIGNAL_VOICE_MAX_CALL_SECONDS=600

# Public domain for automatic HTTPS. Only used with the TLS overlay (below).
# DOMAIN=curia.example.com

# TLS overlay selection. `install.sh` sets this automatically when you choose
# the "public domain + HTTPS" option so every `docker compose` command applies
# the Caddy overlay without a manual -f flag. Uncomment to enable by hand:
# COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml

# Public origin of the office console, e.g. https://curia.example.com. Curia uses
# it for links in documents and job emails, the Secure flag on session cookies,
# the one origin CORS allows, and phone push (which needs https). Unset falls back
# to http://localhost:<HTTP_PORT>, which only suits local evaluation.
# With the TLS overlay, install.sh sets https://<DOMAIN> when this is missing or
# empty, on fresh installs and re-runs alike. A value you set is never changed.
# Behind your own proxy, set it to the URL people use to reach Curia.
# APP_ORIGIN=https://curia.example.com

# Postgres host port (Docker Compose). Override only if 5432 is already bound on
# the host — e.g. running a parallel curia stack against a sibling clone for
# install testing. Leave at the default for the common case.
# IMPORTANT: if you change this, update the port in DATABASE_URL above to match —
# host-side migrations connect via DATABASE_URL, not via the docker network.
# POSTGRES_PORT=5432

# Postgres host bind address (Docker Compose). Defaults to 127.0.0.1, so the
# database is reachable only from this host (host-side tools use localhost).
# install.sh stops and asks when Docker publishes Postgres beyond loopback;
# only a non-loopback POSTGRES_BIND (a deliberate opt-in) skips that check.
# Remote database access is an explicit opt-in: set this to 0.0.0.0 (IPv4),
# :: (IPv4 + IPv6, like releases before #2408), or a specific interface address.
# Docker's published ports bypass host firewalls such as ufw. Loopback values
# (127.0.0.0/8, ::1, localhost) keep Postgres on this host; any other value
# exposes it to every network that can reach that interface. Prefer an SSH tunnel instead
# (ssh -L 15432:127.0.0.1:${POSTGRES_PORT:-5432} <host>, then connect to localhost:15432).
# POSTGRES_BIND=127.0.0.1

# Secrets vault master key — encrypts all stored credentials (AES-256-GCM). REQUIRED.
# 32 random bytes, base64-encoded. Generate: openssl rand -base64 32
# pnpm run setup fills this in automatically.
SECRET_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# Nylas email polling interval in milliseconds (default: 30000 = 30 seconds).
# Non-secret config; NYLAS_API_KEY (the shared app key) lives in the vault.
# Per-account grants (grant ID, self-email) are configured in the console
# (Settings → Channels → Email → Email accounts) and stored in the vault at
# channel.email.<name>.nylas_grant_id — not as env vars.
# NYLAS_POLL_INTERVAL_MS=30000

# Timezone — IANA timezone for the CEO's default location.
# Used to resolve relative dates ("next Friday") in agent prompts.
# Override via KG entity fact when traveling (future feature).
TIMEZONE=America/Toronto

# === Optional: web browser container (docker-compose.yml `browser` service) ===
# The web-browser skill drives Chromium in its own container. These settings are
# read by that container, not by Curia (the container gets nothing else from this
# file). TIMEZONE above also sets the browser's timezone.
# Locale (BCP 47) and the ordered navigator.languages / Accept-Language list.
# Match them to the principal's country and the egress IP.
#BROWSER_LOCALE=en-US
#BROWSER_LANGUAGES=en-US,en
# Egress proxy, e.g. a residential exit so sites do not see a datacenter IP.
# http://host:port or socks5://host:port; no credentials (Chrome cannot send them).
#BROWSER_PROXY=

# === Optional: AWS Bedrock (Claude via the Converse API) ===
#
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are vault-managed secrets, NOT .env
# values — seed them with `aws_access_key_id` / `aws_secret_access_key` (see
# docs/dev/configuration.md). Bedrock is registered only when both secrets AND
# AWS_REGION are present. Which tier uses which Bedrock model is set in
# config/local.yaml's model_routing block (never default.yaml), using an
# inference-profile id such as global.anthropic.claude-sonnet-4-6.
# AWS_REGION=ca-central-1
# AWS_BEDROCK_TIMEOUT=120   # seconds

# Logging
LOG_LEVEL=info
