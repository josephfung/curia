node_modules
dist
.env
.env.*
*.log
.git
.github
docs
tests
coverage
*.md
!README.md
# Bundled embedder weights (#2023): the build stage fetches and verifies them itself, so a
# copy a developer fetched locally (`pnpm fetch:embedder`) must never reach the image.
# Only the pinned manifest the fetch reads goes into the context.
models/embedding/*
!models/embedding/manifest.json
docker/*
!docker/postgres.Dockerfile
!docker/postgres-init-pgaudit.sql
!docker/postgres-verify-pgaudit.sh
# Needed by the main Dockerfile's install steps (#1699) — without this exception
# the COPY fails with "not found in build context" and every build breaks.
!docker/pnpm-retry.sh
# The browser image's entrypoint (docker/browser.Dockerfile, #2541).
!docker/browser-entrypoint.sh
